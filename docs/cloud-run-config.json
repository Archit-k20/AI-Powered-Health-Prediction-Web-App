{
  "metadata": {
    "annotations": {
      "run.googleapis.com/client-name": "gcloud",
      "run.googleapis.com/client-version": "579.0.0",
      "run.googleapis.com/ingress": "all",
      "run.googleapis.com/ingress-status": "all",
      "run.googleapis.com/maxScale": "1",
      "run.googleapis.com/urls": "[\"https://health-api-888697615614.us-central1.run.app\",\"https://health-api-2uzgzq224q-uc.a.run.app\"]"
    }
  },
  "spec": {
    "template": {
      "metadata": {
        "annotations": {
          "autoscaling.knative.dev/maxScale": "1",
          "run.googleapis.com/client-name": "gcloud",
          "run.googleapis.com/client-version": "579.0.0",
          "run.googleapis.com/cpu-throttling": "true",
          "run.googleapis.com/startup-cpu-boost": "false"
        }
      },
      "spec": {
        "containerConcurrency": 4,
        "containers": [
          {
            "resources": {
              "limits": {
                "cpu": "1",
                "memory": "1Gi"
              }
            },
            "startupProbe": {
              "failureThreshold": 12,
              "httpGet": {
                "path": "/api/v1/health",
                "port": 8080
              },
              "periodSeconds": 10,
              "timeoutSeconds": 5
            }
          }
        ],
        "timeoutSeconds": 120
      }
    }
  },
  "status": {
    "url": "https://health-api-2uzgzq224q-uc.a.run.app"
  }
}
